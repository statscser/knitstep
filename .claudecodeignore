node_modules/
bower_components/
vendor/
packages/*/node_modules/
.pnp*
.yarn/

# --- 编译产物与缓存 (Build Outputs & Cache) ---
dist/
build/
out/
.next/
.nuxt/
.cache/
*.pyc
__pycache__/
target/
bin/
obj/

